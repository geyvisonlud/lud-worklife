# PostgreSQL database (Neon, Supabase, Vercel Postgres, or the built-in local one)
# Port 5433 so it can run next to Lud Finances (5432) on the same computer.
DATABASE_URL="postgresql://worklife:worklife@localhost:5433/worklife"
DATABASE_URL_UNPOOLED="postgresql://worklife:worklife@localhost:5433/worklife"

# Who can sign in. With none of these set the app has no login (fine on your own computer).
ALLOWED_EMAILS=""
APP_PASSWORD="change-this-password"
# Signs the session cookie and OAuth state (any long random string: openssl rand -hex 32)
SESSION_SECRET="generate-with-openssl-rand-hex-32"
# Encrypts Google/Notion tokens in the database (64 hex chars: openssl rand -hex 32). Falls back to SESSION_SECRET.
ENCRYPTION_KEY=""
OWNER_NAME="Geyvison"
# Days, "today" and the calendar grid use this time zone
APP_TIMEZONE="America/New_York"
# Public address (e.g. https://lud-worklife.vercel.app) — used for OAuth redirects and links in Google events
APP_URL=""

# Google — one OAuth client for both sign-in and calendars (console.cloud.google.com → APIs & Services → Credentials).
# Enable the Google Calendar API and the Gmail API. Authorized redirect URIs:
#   <APP_URL>/api/auth/google/callback   (sign in)
#   <APP_URL>/api/google/callback        (connect calendar accounts — add as many Google accounts as you want)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Possible tasks from email: Claude reads new inbox mail (marketing/newsletters are skipped first) and
# suggests the actions that need you. Without a key, simple rules catch clear requests. console.anthropic.com
ANTHROPIC_API_KEY=""

# Notion — either a public integration (OAuth, "Connect Notion" button) …
# notion.so/profile/integrations → New integration → Public. Redirect URI: <APP_URL>/api/notion/callback
NOTION_CLIENT_ID=""
NOTION_CLIENT_SECRET=""
# … or an internal integration secret pasted in Connections (no env needed).
# How far back the first Notion import looks (days)
NOTION_LOOKBACK_DAYS="90"

# Protects /api/cron/sync (Vercel sends "Authorization: Bearer $CRON_SECRET")
CRON_SECRET="generate-with-openssl-rand-hex-32"
